{
  "name": "cloudflare-telegram-private-bot",
  "version": "1.3.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/i18n.js && node --test --test-isolation=none",
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --keep-vars --config wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply BOT_DB --local --config wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply BOT_DB --remote --config wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
